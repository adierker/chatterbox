{
	"name": "chatterbox",
	"version": "0.1.1",
	"description": "A minimal AI chat panel for Obsidian.",
	"private": true,
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "tsx --test src/*.test.ts",
		"version": "node version-bump.mjs && git add manifest.json",
		"lint": "eslint ."
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"tsx": "^4.23.12",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	},
	"dependencies": {
		"react": "^19.2.8",
		"react-dom": "^19.2.8"
	}
}
